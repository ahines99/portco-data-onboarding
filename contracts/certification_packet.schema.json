{
  "$defs": {
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "JoinCandidate": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "1:1",
            "1:N",
            "N:1",
            "N:M"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "containment_ratio": {
          "title": "Containment Ratio",
          "type": "number"
        },
        "evidence_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "join_id": {
          "title": "Join Id",
          "type": "string"
        },
        "left_columns": {
          "items": {
            "type": "string"
          },
          "title": "Left Columns",
          "type": "array"
        },
        "left_table": {
          "title": "Left Table",
          "type": "string"
        },
        "name_score": {
          "title": "Name Score",
          "type": "number"
        },
        "orphan_rate": {
          "title": "Orphan Rate",
          "type": "number"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "requires_review": {
          "title": "Requires Review",
          "type": "boolean"
        },
        "right_columns": {
          "items": {
            "type": "string"
          },
          "title": "Right Columns",
          "type": "array"
        },
        "right_table": {
          "title": "Right Table",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "join_id",
        "left_table",
        "left_columns",
        "right_table",
        "right_columns",
        "containment_ratio",
        "orphan_rate",
        "cardinality",
        "name_score",
        "score",
        "confidence",
        "requires_review"
      ],
      "title": "JoinCandidate",
      "type": "object"
    },
    "MetricCertification": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "generated",
            "not_generated",
            "reference_only"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "description",
        "formula",
        "status"
      ],
      "title": "MetricCertification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "failing_checks": {
      "items": {
        "type": "string"
      },
      "title": "Failing Checks",
      "type": "array"
    },
    "joins": {
      "items": {
        "$ref": "#/$defs/JoinCandidate"
      },
      "title": "Joins",
      "type": "array"
    },
    "manifest_hash": {
      "title": "Manifest Hash",
      "type": "string"
    },
    "mapping_hash": {
      "title": "Mapping Hash",
      "type": "string"
    },
    "mapping_summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Mapping Summary",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricCertification"
      },
      "title": "Metrics",
      "type": "array"
    },
    "open_findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Open Findings",
      "type": "array"
    },
    "reviewer_overrides": {
      "items": {
        "type": "string"
      },
      "title": "Reviewer Overrides",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "test_report_passed": {
      "title": "Test Report Passed",
      "type": "boolean"
    },
    "waived_checks": {
      "items": {
        "type": "string"
      },
      "title": "Waived Checks",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "manifest_hash",
    "mapping_hash",
    "joins",
    "mapping_summary",
    "reviewer_overrides",
    "metrics",
    "test_report_passed",
    "failing_checks",
    "waived_checks",
    "open_findings",
    "evidence_ids"
  ],
  "title": "CertificationPacket",
  "type": "object"
}
