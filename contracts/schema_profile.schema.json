{
  "$defs": {
    "ColumnProfile": {
      "additionalProperties": false,
      "properties": {
        "category_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Values"
        },
        "column": {
          "title": "Column",
          "type": "string"
        },
        "comment_flagged": {
          "default": false,
          "title": "Comment Flagged",
          "type": "boolean"
        },
        "distinct_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct Count"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "evidence_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "inferred_semantic_type": {
          "$ref": "#/$defs/SemanticType",
          "default": "unknown"
        },
        "integer_valued": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integer Valued"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Value"
        },
        "mean_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Value"
        },
        "negative_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Count"
        },
        "non_null_count": {
          "title": "Non Null Count",
          "type": "integer"
        },
        "null_pct": {
          "title": "Null Pct",
          "type": "number"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        },
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "pattern_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Pattern Counts",
          "type": "object"
        },
        "pattern_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern Signature"
        },
        "pii_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/PiiClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pii_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "uniqueness_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uniqueness Ratio"
        }
      },
      "required": [
        "table",
        "column",
        "ordinal",
        "dtype",
        "row_count",
        "non_null_count",
        "null_pct"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "PiiClass": {
      "enum": [
        "email",
        "phone",
        "national_id",
        "payment_card",
        "person_name",
        "address",
        "dob",
        "ip_address",
        "free_text_may_contain_pii"
      ],
      "title": "PiiClass",
      "type": "string"
    },
    "SemanticType": {
      "enum": [
        "id",
        "money",
        "quantity",
        "date",
        "timestamp",
        "date_string",
        "category",
        "boolean",
        "code",
        "free_text",
        "numeric",
        "mixed",
        "unknown"
      ],
      "title": "SemanticType",
      "type": "string"
    },
    "TableProfile": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnProfile"
          },
          "title": "Columns",
          "type": "array"
        },
        "comment_flagged": {
          "default": false,
          "title": "Comment Flagged",
          "type": "boolean"
        },
        "evidence_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "freshness_max_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness Max Date"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "schema_name": {
          "title": "Schema Name",
          "type": "string"
        },
        "table_name": {
          "title": "Table Name",
          "type": "string"
        }
      },
      "required": [
        "schema_name",
        "table_name",
        "row_count",
        "columns"
      ],
      "title": "TableProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "title": "Company Id",
      "type": "string"
    },
    "connection_id": {
      "title": "Connection Id",
      "type": "string"
    },
    "profile_id": {
      "format": "uuid",
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_fingerprint": {
      "title": "Source Fingerprint",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/TableProfile"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "connection_id",
    "company_id",
    "source_fingerprint",
    "tables"
  ],
  "title": "SchemaProfile",
  "type": "object"
}
