# Copy to .env. Every setting has a safe default; nothing here is required for the demo.
PORTCO_ENV=dev
PORTCO_VAR_ROOT=var
# SQLite by default; set for Postgres (docker compose up -d postgres):
# PORTCO_DATABASE_URL=postgresql+psycopg://portco:portco@localhost:5432/portco
PORTCO_LOG_LEVEL=INFO

# Workflow policy
PORTCO_STEP_MAX_ATTEMPTS=3
PORTCO_STEP_TIMEOUT_SECONDS=300
PORTCO_REQUIRE_DISTINCT_REVIEWER=true
PORTCO_APPROVAL_TTL_HOURS=72

# Optional LLM mapping judge (off by default; see docs/adr/0010-llm-mapping-judge.md)
PORTCO_LLM_ENABLED=false
PORTCO_LLM_MODEL=claude-opus-5
PORTCO_LLM_MODE=replay
# PORTCO_ANTHROPIC_API_KEY=

# MCP identity (stdio transport). The agent principal can never approve.
PORTCO_LOCAL_PRINCIPAL_ID=agent:local
PORTCO_LOCAL_PRINCIPAL_ROLE=agent
# HTTP bearer tokens: token=principal:role:company1|company2;... (`*` = all companies).
# A token without companies can reach no tenant. The HTTP app refuses to start without tokens.
# PORTCO_HTTP_TOKENS=dev-agent=agent:claude:agent:portco_a;dev-reviewer=alice:reviewer:portco_a
PORTCO_HTTP_BASE_URL=http://localhost:8000

# Fault injection for demos/tests, e.g. adapter.aggregate:timeout:nth=3 (refused in production)
PORTCO_FAULTS=
